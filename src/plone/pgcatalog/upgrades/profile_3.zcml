<configure
    xmlns="http://namespaces.zope.org/zope"
    xmlns:gs="http://namespaces.zope.org/genericsetup"
    i18n_domain="plone.pgcatalog"
    >

  <gs:upgradeStep
      profile="plone.pgcatalog:default"
      source="2"
      destination="3"
      title="Resync getObjPositionInParent ranks"
      description="Plone never reindexes siblings after a reordering, so
                   position snapshots written before the gopip resync
                   subscriber existed are stale and folder_contents drag
                   &amp; drop aborts on the mismatch.  Resync all ordered
                   folders against their ZODB ordering.  See #216."
      handler=".profile_3.resync_gopip_ranks"
      />

</configure>
